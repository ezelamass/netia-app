# Frontend (Vite). Se cargan en Vercel o en un .env local.
# Los valores están en Supabase: Project Settings > API.
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<anon / publishable key>"
VITE_SUPABASE_PROJECT_ID="<project-ref>"

# Las Edge Functions leen sus secrets desde Supabase (no van en este archivo):
#   OPENAI_API_KEY      obligatorio para el chat, la voz y el RAG
#   ALLOWED_ORIGINS     opcional, dominios extra permitidos por CORS (separados por coma)
#   OPENAI_CHAT_MODEL   opcional, por defecto gpt-4o-mini
